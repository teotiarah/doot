# Curated checks (D051). The set is chosen to catch real defects in C without
# generating advice that fights the project's own conventions -- an advisory gate
# is a gate that is off, so everything enabled here must stay clean.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-assignment-in-if-condition,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-no-recursion,
  -misc-include-cleaner,
  -readability-redundant-declaration,
  -clang-analyzer-valist.Uninitialized,
  -bugprone-reserved-identifier

# Three checks are disabled deliberately. All are configuration in this file, not
# inline suppression in source, which D053 forbids. The rule applied when deciding:
# a check that correct code cannot satisfy is not a check (D055).
#
# misc-include-cleaner wants every used symbol's defining header included
# directly, which contradicts the project's layered headers (diag.h includes
# source.h includes slice.h includes arena.h). That is a style opinion rather
# than a defect check, and -Wmissing-prototypes already enforces the property
# that matters -- that a header declares exactly its own public surface.
#
# clang-analyzer-valist.Uninitialized reports false positives on the canonical
# variadic pattern:
#
#     va_start(ap, fmt);
#     vfprintf(stderr, fmt, ap);
#     va_end(ap);
#
# whether it fires depends on the host's system headers rather than on the code:
# clean on glibc 2.34, firing on glibc 2.39 with the same clang-tidy version,
# alongside thousands of suppressed analyzer warnings from those headers. The
# flagged code is textbook-correct C99 and cannot be rewritten to satisfy the
# checker, so keeping it enabled would mean the gate passes or fails based on the
# runner image -- which is not a gate.
#
# Residual risk accepted: the checker would otherwise catch use-before-va_start,
# a missing va_end, and use-after-va_end. doot has six variadic functions, all in
# src/base, all covered by unit tests, and all clean under ASan and UBSan. If the
# upstream checker becomes host-independent, this line comes back out.
#
# bugprone-reserved-identifier flags `#define _POSIX_C_SOURCE 200809L`, which is
# correct: the identifier is reserved to the implementation. But defining it is
# also the only standard way to ask for POSIX, and src/base/fs.c needs opendir and
# stat because ISO C has no directory traversal.
#
# It cannot move to the build flags. D035 requires that `cc -O2 -o doot
# build/doot.c` builds the whole project with no other arguments, so the
# amalgamation carries no -D options and the macro has to be in the source.
#
# Residual risk accepted: the checker would otherwise catch a genuinely
# ill-advised identifier -- a leading underscore on a file-scope name, or a name
# containing a double underscore. -Wall -Wextra -Wpedantic do not cover that, so
# this one is a real loss rather than a false positive being silenced. It is
# bounded by there being exactly one reserved identifier in the tree, which is
# greppable: `grep -rn '_POSIX_C_SOURCE' src`. If clang-tidy grows an option to
# allow specific feature-test macros, this line comes back out.

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|tests|fuzz)/.*\.h$'
FormatStyle: file
